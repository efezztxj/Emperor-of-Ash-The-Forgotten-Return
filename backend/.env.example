# --- Sağlayıcı seçimi: mock | openai | local | gemini | openrouter ---------
AI_PROVIDER=mock

# --- Bulut (OpenAI-uyumlu) -------------------------------------------------
# OpenAI, OpenRouter, Groq, DeepSeek, Together... hepsi aynı format.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# --- Yerel (Ollama / LM Studio / vLLM) ------------------------------------
# Ollama: `ollama serve` + `ollama pull qwen3:8b`
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen3:8b

# --- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Davranış -------------------------------------------------------------
REQUEST_TIMEOUT_S=30
MAX_OUTPUT_TOKENS=600
DEFAULT_TEMPERATURE=0.8
# Ağ yoksa sabit diyaloga düş (oyun kilitlenmesin)
OFFLINE_FALLBACK=true
# Dakikada istek sınırı (0 = kapalı) — fatura koruması
MAX_REQUESTS_PER_MINUTE=60
